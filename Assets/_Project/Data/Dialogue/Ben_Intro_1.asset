  defaultSpeaker: {fileID: 11400000, guid: 3bad4e0fce8fe5a4e88a48519dd04ce6, type: 2}
  lines:
  - speaker: {fileID: 0}
    text: "Chegou de mansinho, hein? Senta a\xED um minuto, sobrinho."
    choices: []
    eventId: 
  - speaker: {fileID: 0}
    text: "Faz tempo que a gente n\xE3o conversa direito. Eu fico aqui vendo o movimento do restaurante e pensando na vida."
    choices: []
    eventId: 
  - speaker: {fileID: 0}
    text: "Me conta: voc\xEA ainda cozinha como sua bisav\xF3 ensinou, ou inventou moda?"
    choices: []
