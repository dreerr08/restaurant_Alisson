  m_Script: {fileID: 11500000, guid: 942acb0052985e7478c1e23feef0d44c, type: 3}
  m_Name: TioBen_Inicial
  m_EditorClassIdentifier: Assembly-CSharp::AliGame.Data.DialogueSO
  defaultSpeaker: {fileID: 11400000, guid: 3bad4e0fce8fe5a4e88a48519dd04ce6, type: 2}
  lines:
  - speaker: {fileID: 0}
    text: "Ora, ora! Se n\xE3o \xE9 o meu sobrinho favorito! Vem c\xE1, deixa eu
      te olhar."
    choices: []
    eventId: 
  - speaker: {fileID: 0}
    text: "Faz tempo que n\xE3o aparece por aqui. Como v\xE3o as coisas no restaurante?"
    choices: []
    eventId: 
  - speaker: {fileID: 0}
    text: Mas me diz, precisa de alguma coisa?
    choices:
    - label: "Me d\xE1 uma dica de cozinha."
      next: {fileID: 11400000, guid: 4934c368136922341aae0f3f88ff6667, type: 2}
      eventId: 
    - label: "Como est\xE1 a vida de sapo?"
      next: {fileID: 11400000, guid: 22eadf10faa938e49b109d3f215465e0, type: 2}
      eventId: 
    - label: "S\xF3 passei para dar um oi."
      next: {fileID: 11400000, guid: b3b3688150b20394980d967ddd1de554, type: 2}
      eventId: 
    eventId: 
