  defaultSpeaker: {fileID: 11400000, guid: 3bad4e0fce8fe5a4e88a48519dd04ce6, type: 2}
  lines:
  - speaker: {fileID: 0}
    text: "Anota a\xED, sobrinho: cada receita s\xF3 sai na bancada certa."
    choices: []
    eventId: 
  - speaker: {fileID: 0}
    text: "Corte os ingredientes na Esta\xE7\xE3o de Corte, misture na Esta\xE7\xE3o
      de Mistura e leve tudo ao Fog\xE3o para finalizar."
    choices: []
    eventId: 
  - speaker: {fileID: 0}
    text: "E se algo cair no ch\xE3o, relaxa: o \xEDm\xE3 cuida de recolher, hehe."
    choices: []
    eventId: 
